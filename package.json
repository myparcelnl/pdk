{
  "name": "@myparcel/php-pdk",
  "private": true,
  "license": "MIT",
  "scripts": {
    "__analyse": "pnpm docker composer analyse",
    "__console:generate:docs": "pnpm console -- generate:docs",
    "__console:generate:factory": "pnpm console -- generate:factory",
    "__console:generate:ide-helper": "pnpm console -- generate:ide-helper",
    "__console:generate:typescript": "pnpm console -- generate:typescript",
    "__console:parse": "pnpm console -- parse",
    "__lint": "prettier --cache --check .",
    "__lint:fix": "prettier --cache --write .",
    "__quality": "pnpm docker composer quality",
    "__quality:fix": "pnpm docker composer quality:fix",
    "__test:coverage": "pnpm docker composer test:unit:coverage",
    "__test:integration": "pnpm docker composer test:integration",
    "__test:unit": "pnpm docker composer test:unit",
    "analyse": "nx run @myparcel/php-pdk:__analyse",
    "analyse:generate": "pnpm docker composer analyse:generate",
    "analyze": "pnpm run analyse",
    "analyze:generate": "pnpm run analyse:generate",
    "console": "pnpm docker composer console",
    "console:generate:docs": "nx run @myparcel/php-pdk:__console:generate:docs",
    "console:generate:factory": "nx run @myparcel/php-pdk:__console:generate:factory",
    "console:generate:ide-helper": "nx run @myparcel/php-pdk:__console:generate:ide-helper",
    "console:generate:typescript": "nx run @myparcel/php-pdk:__console:generate:typescript",
    "console:parse": "nx run @myparcel/php-pdk:__console:parse",
    "docker": "docker compose run --rm -T php",
    "lint": "nx run @myparcel/php-pdk:__lint",
    "lint:fix": "nx run @myparcel/php-pdk:__lint:fix",
    "prepare": "is-ci || husky",
    "quality": "nx run @myparcel/php-pdk:__quality",
    "quality:fix": "nx run @myparcel/php-pdk:__quality:fix",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "nx run @myparcel/php-pdk:__test:coverage",
    "test:integration": "nx run @myparcel/php-pdk:__test:integration",
    "test:unit": "nx run @myparcel/php-pdk:__test:unit",
    "test:unit:coverage": "nx run @myparcel/php-pdk:__test:coverage",
    "test:unit:snapshot": "pnpm docker composer test:unit:snapshot",
    "test:watch": "pnpm dlx nodemon --exec 'pnpm test || exit 1' --watch 'src,tests' --ext 'php'"
  },
  "lint-staged": {
    "*.{md,yml,json,html}": "prettier --write",
    "*.php": "pnpm quality:fix"
  },
  "release": {
    "extends": "@myparcel-dev/semantic-release-config/github-composer"
  },
  "devDependencies": {
    "@myparcel-dev/semantic-release-config": "^8.1.0",
    "@myparcel/prettier-config": "^1.1.0",
    "husky": "^9.0.0",
    "is-ci": "^4.1.0",
    "lint-staged": "^15.0.0",
    "nx": "^24.0.6",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.9"
  },
  "nx": {
    "namedInputs": {
      "production": [
        "!{workspaceRoot}/**/.tmp/**/*",
        "!{workspaceRoot}/**/.cache/**/*",
        "{workspaceRoot}/composer.json",
        "{workspaceRoot}/config/**/*",
        "{workspaceRoot}/src/**/*"
      ],
      "test": [
        "production",
        "{workspaceRoot}/tests/**/*"
      ],
      "console": [
        "production",
        "{workspaceRoot}/private/**/*"
      ]
    },
    "targets": {
      "__console:parse": {
        "cache": true,
        "inputs": [
          "console"
        ],
        "outputs": [
          "{workspaceRoot}/.cache/console"
        ]
      },
      "__console:generate:docs": {
        "cache": true,
        "dependsOn": [
          "__console:parse"
        ],
        "inputs": [
          "console"
        ],
        "outputs": [
          "{workspaceRoot}/docs"
        ]
      },
      "__console:generate:ide-helper": {
        "cache": true,
        "dependsOn": [
          "__console:parse"
        ],
        "inputs": [
          "console"
        ],
        "outputs": [
          "{workspaceRoot}/.meta/pdk_ide_helper.php"
        ]
      },
      "__console:generate:typescript": {
        "cache": true,
        "dependsOn": [
          "__console:parse"
        ],
        "inputs": [
          "console"
        ],
        "outputs": []
      },
      "__console:generate:factory": {
        "cache": true,
        "dependsOn": [
          "__console:parse"
        ],
        "inputs": [
          "console"
        ],
        "outputs": []
      },
      "__quality": {
        "cache": true,
        "inputs": [
          "production"
        ]
      },
      "__quality:fix": {
        "cache": true,
        "inputs": [
          "production"
        ]
      },
      "__lint": {
        "cache": true,
        "inputs": [
          "production"
        ],
        "outputs": [
          "{workspaceRoot}/node_modules/.cache/prettier"
        ]
      },
      "__lint:fix": {
        "cache": true,
        "inputs": [
          "production"
        ],
        "outputs": [
          "{workspaceRoot}/node_modules/.cache/prettier"
        ]
      },
      "__analyse": {
        "cache": true,
        "inputs": [
          "test"
        ]
      },
      "__test:unit": {
        "cache": true,
        "inputs": [
          "!{workspaceRoot}/tests/Integration/**/*",
          "test"
        ]
      },
      "__test:coverage": {
        "cache": true,
        "inputs": [
          "!{workspaceRoot}/tests/Integration/**/*",
          "test"
        ],
        "outputs": [
          "{workspaceRoot}/clover.xml"
        ]
      },
      "__test:integration": {
        "cache": true,
        "inputs": [
          "!{workspaceRoot}/tests/Unit/**/*",
          "test"
        ]
      }
    }
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.21"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.11",
      "onFail": "download"
    }
  }
}
